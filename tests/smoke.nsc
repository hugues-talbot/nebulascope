# NebulaScope smoke test — run from the repo root:
#   ./build/src/nebulascope --run tests/smoke.nsc
# Headless (CI):  QT_QPA_PLATFORM=offscreen … --run tests/smoke.nsc
# Also registered as the `smoke` CTest (offscreen, cwd = repo root).
# Outputs are written to the working directory (smoke_*.png/.fits/.xisf,
# gitignored) — relative paths keep this portable to Windows runners.
# Uses the committed synthetic image (128x128 Float32 gradient + gaussian
# stars, values ~50..1340, pixel [0,0] NaN).

open tests/testdata/sample.fits
waitloaded                      # block until decode + stats land (CI-safe)

assert size 128 128
assert channels 1
assert range 50.4 1339.9 5

# Orientation round-trip: the border-bug regression, end to end.
rotate 45
sleep 200
rotate 0
sleep 200
waitloaded
assert size 128 128

# Lossless geometry round-trips preserve the data extremes.
rot90 cw
rot90 ccw
flip h
flip h
assert size 128 128
assert range 50.4 1339.9 5

# Stretch + adjustments exercise the full render path.
autostf
stfall
fn asinh
adjust saturation 0.3
adjust gamma 1.4
reset

export smoke_view.png
save smoke_data.fits

# XISF round-trip through the app: save (normalized to [0,1] with
# NSSCALE/NSZERO keywords, zlib+shuffle blocks), reload, verify.
save smoke_data.xisf
open smoke_data.xisf
waitloaded
assert size 128 128
assert channels 1
assert range 0.0 1.0 0.01

# OSC debayer end to end: the real ASIAIR CFA fixture auto-detects RGGB and
# opens as RGB; forcing off shows the raw mosaic again.
open tests/testdata/cfa_asiair_rggb.fits
waitloaded
assert channels 3
assert size 128 128
debayer off
waitloaded
assert channels 1
debayer auto
waitloaded
assert channels 3

# Debayer changes are undoable: undo the `debayer auto` above (back to the
# raw mosaic), redo it (colour again).
action undo
waitloaded
assert channels 1
action redo
waitloaded
assert channels 3

# Blink culling: tag (checked = keep), sort, remove, move — end to end.
assert rows 3
tag off                          # reject the CFA frame (current)
tagsort                          # unchecked sinks below the keepers
tagremove unchecked
assert rows 2
show 1
waitloaded
save smoke_cull.fits
open smoke_cull.fits
waitloaded
tag off
tagmove unchecked smoke_cull_out
assert rows 3
show 3                           # the moved row re-keyed to its new home
waitloaded
assert size 128 128

# Full-depth crop: a new in-memory entry at the exact size, saveable and
# reloadable (WCS rebasing is covered by the wcs unit tests).
crop 10 20 64 48
waitloaded
assert size 64 48
assert rows 4
save smoke_crop.fits
# Saving an in-memory result rebrands its list row to the saved file —
# so re-opening the file finds the EXISTING row (no new entry).
assert name smoke_crop.fits
open smoke_crop.fits
waitloaded
assert size 64 48
assert rows 4

# The list holds each image once: re-opening a listed file selects the
# existing row instead of appending a duplicate.
open smoke_crop.fits
waitloaded
assert rows 4
assert name smoke_crop.fits

# Stretch history: gestures coalesce onto the undo stack; Reload Original
# re-runs the first-view rules and is itself one undoable step.
autostf
sleep 900
action undo
action redo
action reload_original
sleep 200
action undo

# Sidecar display round-trip: Save Annotations & Display snapshots the FULL
# appearance (transfer fn, windowing, adjustments — the shape a
# non-destructive transport fit produces), and a fresh open (Clear List
# forgets STF memory; the sidecar is re-read) restores it exactly, winning
# over the first-view auto rules.
fn ghs
adjust hue -0.99995914
adjust saturation 0.11033605
adjust temperature -0.0738426
adjust gamma 1.3
sleep 800
action save_annotations
action clear_list
assert rows 0
open smoke_crop.fits
waitloaded
assert rows 1
assert fn ghs
assert adjust hue -0.99995914 1e-6
assert adjust saturation 0.11033605 1e-6
assert adjust temperature -0.0738426 1e-6
assert adjust gamma 1.3 1e-6

# DisplayFunction import matrix (synthetic fixtures; expected values from
# tests/testdata/make_df_fixtures.py — same closed-form Mobius rebase).
open tests/testdata/df_unlinked.xisf
waitloaded
assert rows 2
assert stretch 0 0.000300000014 0.00139345469 0.0129000004 2e-7
assert stretch 1 0.0004 0.000780958047 0.00482302913 2e-7
assert stretch 2 0.000369999994 0.000916627138 0.00670534967 2e-7
open tests/testdata/df_linked.xisf
waitloaded
assert stretch 0 0.000300000014 0.00151418714 0.0129000004 2e-7
assert stretch 1 0.00039999999 0.00161406566 0.01299874 2e-7
assert stretch 2 0.000369999994 0.0015841021 0.0129691182 2e-7
open tests/testdata/df_inrange.xisf
waitloaded
assert stretch 0 0.0005 0.003275 0.0116 2e-7
assert stretch 1 0.0006 0.0012 0.003 2e-7
assert stretch 2 0.0005 0.000925 0.0022 2e-7
assert rows 4

# C (close_image) closes the highlighted rows — here just the current one —
# and frees their memory through the shared removeSelected() path.
action close_image
assert rows 3
assert name df_linked.xisf

# Values in All Views (V): hover fans the active pixel out to every cell's
# own data as an overlay; off again clears. Exercised through the script
# hover + values_everywhere paths (rendering checked in the capture tests).
action values_everywhere
hover 10 10
sleep 100
hover off
action values_everywhere

# Register from features: ground-truth similarity q = 0.5·R(30°)·p + (7,−3).
# One pair snaps translation exactly (p1→q1); a second pair solves scale +
# rotation + translation in closed form — exact on both pairs AND on an
# unpicked third point, in both directions. (Two different files: the list
# dedupes, so a split needs two distinct entries.)
open tests/testdata/sample.fits
waitloaded
open tests/testdata/cfa_asiair_rggb.fits
waitloaded
split 1x2
activate 1
action register_views
regpick 1 20 30
regpick 2 8.160254 14.990381
assert mapped 20 30 2 8.160254 14.990381 1e-3
action register_views_2
regpick 1 90 40
regpick 2 35.971143 36.820508
assert mapped 20 30 2 8.160254 14.990381 1e-3
assert mapped 90 40 2 35.971143 36.820508 1e-3
assert mapped 50 100 2 3.650635 52.801270 1e-3
activate 2
assert mapped 3.650635 52.801270 1 50 100 1e-3
# Reset Orientation is FORCEFUL: it vacates the calibration worlds and view
# navigation everywhere (the field stuck-state: a Match with reversed pick
# order rotates a viewport, auto-links propagate it, and no per-image action
# could clear it). After reset, a fresh Match must start from clean state.
action reset_orientation
activate 1
action register_views
regpick 1 10 10
regpick 2 30 40
assert mapped 10 10 2 30 40 1e-3
action reset_orientation
split 1x1

# Extended window domain + common axis. On the 3-channel pi_f32 fixture:
# black BELOW the data minimum and white ABOVE the maximum are legal and
# read back exactly (raw units); toggling the axis policy re-expresses the
# handles on new ranges without moving them (display-invariant).
open tests/testdata/pi_f32_plain.xisf
waitloaded
assert channels 3
window all -0.25 0.4 1.3
assert stretch 0 -0.25 0.4 1.3 1e-6
assert stretch 2 -0.25 0.4 1.3 1e-6
axis channel
assert stretch 0 -0.25 0.4 1.3 1e-6
assert stretch 1 -0.25 0.4 1.3 1e-6
axis common
assert stretch 2 -0.25 0.4 1.3 1e-6
# GHS with the symmetry point outside the window still renders (monotone
# curve; see test_core) — set it through the value path and bake.
fn ghs
bake smoke_ghs_ext.fits
reset
# Dragging a grip past the plot edge extends the axis and takes the handle
# with it: after a 400 px leftward drag of B, the black point is below the
# data minimum (the fixture's min is ~0.23 on channel 0).
fn linear
histdrag b -400
sleep 100
assert stretch 0 -1 0.5 1.0 0.9      # black well below 0.23; mid/white untouched (loose)
# Narrowing the window (drag W far left) keeps M between B and W (midtone
# carried as a ratio, never a wall) and — on release — the plot zooms to the
# window so the distribution inside it is legible. On the pi_f32 fixture
# (channel-0 data ~0.23..1.0) a leftward W drag narrows the window and keeps
# M at the black+ratio*(white-black) position (midtone carried, not a wall).
fn linear
action reset_stretch
histdrag w -330
sleep 100
assert stretch 0 0.2302 0.3064 0.3826 0.02

# Combine "As displayed" must not quantize: three mono sources with STEEP
# GHS stretches (SP on the mode) bake through INTERPOLATED transfer LUTs —
# nearest-lookup posterized the result to ~slope/4096 output steps while the
# display (interpolated) looked smooth. The combine of three 128x128 sources
# must keep (nearly) per-pixel level richness. (Fresh 3-row list: the
# dialog's combo indices depend on the number of mono rows.)
action clear_list
open tests/testdata/sample.fits
waitloaded
save smoke_comb2.fits
save smoke_comb3.fits
autostf
fn ghs
axis peak
open smoke_comb2.fits
waitloaded
autostf
fn ghs
axis peak
open smoke_comb3.fits
waitloaded
autostf
fn ghs
axis peak
dialog combine
dlgcombo 0 S
dlgcombo 1 H
dlgcombo 2 O
dlgclick SHO
dlgcombo 3 As
dlgclick Create Image
sleep 400
waitloaded
assert channels 3
assert levels 0 3000
action undo
sleep 200

# Match from plate solutions: both views solved (TAN; 2"/px unrotated vs
# 0.5"/px rotated 30°, same centre) → M needs no picks. The fitted affine
# must agree with the projections (pixel→sky→pixel) to 0.02 px, both ways.
split 1x2
activate 1
open tests/testdata/wcs_wide.fits        # into cell 1 (active)
waitloaded
activate 2
open tests/testdata/wcs_narrow.fits      # into cell 2 (active)
waitloaded
activate 1
action register_views
sleep 200
assert wcsmatch 2 64 64 0.02
assert wcsmatch 2 40 50 0.02
assert wcsmatch 2 80 90 0.02
activate 2
assert wcsmatch 1 64 64 0.02
assert wcsmatch 1 20 100 0.02
split 1x1

# Metadata-less CFA: a raw mosaic dumped into plain grayscale PNG (planetary/
# solar capture streams). Auto can't demosaic (no BAYERPAT anywhere); a
# forced pattern must; `all` stamps the choice onto every listed frame.
open tests/testdata/cfa_asiair_rggb.fits
waitloaded
assert channels 3
open tests/testdata/cfa_gray.png
waitloaded
assert channels 1
debayer rggb rcd
waitloaded
assert channels 3
assert pixel 32 32 0.78431 0.47059 0.23529 0.004
debayer off all
waitloaded
assert channels 1
open tests/testdata/cfa_asiair_rggb.fits    # re-open = select its existing row
waitloaded
assert name cfa_asiair_rggb.fits
assert channels 1
debayer auto all
waitloaded
assert channels 3

# Rotated navigation (a calibrated Match with rotated correspondence): the
# region export is WYSIWYG — the rotated frame as shown, never the unrotated
# bounding box — and a data crop stays INSIDE the visible quad (the bbox
# would sample off-screen sky; that superset also fed OT's relevance mask —
# the "khaki wash" field report). 45-degree ground truth: q = R(45)(p - p1) + q1.
action clear_list
open tests/testdata/sample.fits
waitloaded
open tests/testdata/cfa_asiair_rggb.fits
waitloaded
split 1x2
activate 1
action register_views
regpick 1 60 60
regpick 2 40 40
action register_views_2
regpick 1 80 60
regpick 2 54.142136 54.142136
sleep 200
activate 2
export region smoke_rotregion.png
action crop_visible
waitloaded
assert rows 3
open smoke_rotregion.png
waitloaded
assert channels 3
assert rows 4
action reset_orientation
split 1x1

# Neutralize Background from Sky Patch: the three channel backgrounds are
# EQUALIZED to a common output grey (the mean of their current levels) by
# solving each black point numerically — midtone and white stay absolute.
# Note ch1's black goes NEGATIVE: its dimmer background is lifted UP to
# the common grey (the extended handle domain at work) — minimum movement,
# both directions, colour cast removed, brightness kept.
open tests/testdata/pi_f32_plain.xisf
waitloaded
window all 0 0.5 1
blackpatch 20 20 40 40
assert stretch 0 0.117384903 0.5 1 5e-4
assert stretch 1 -0.192463505 0.5 1 5e-4
assert stretch 2 0.0385118501 0.5 1 5e-4
action undo

# Measure PSF end to end (script mode prints the report; the 128px fixture
# yields too few isolated stars for a measurement, which the report says
# honestly) and the annotate path with its stale-results guard.
open tests/testdata/sample.fits
waitloaded
action measure_psf
psfannotate 0 10
action undo
action measure_psf
psfannotate 0 5 3
action undo

# Deconvolve guard: this fixture cannot define a kernel (too few fitted
# stars), and the command must say so and change nothing — the delivered-PSF
# contract itself runs in test_deconv on a synthetic field with exact truth.
deconv 2.0

# Decoded-image cache: the third visit to sample.fits in this run serves the
# cached decode — the data must be bit-identical to a fresh read (and an
# in-session save that OVERWRITES a cached file must never be masked: the
# xisf reopen below re-reads because the mtime moved).
open tests/testdata/cfa_asiair_rggb.fits
waitloaded
open tests/testdata/sample.fits
waitloaded
assert size 128 128
assert range 50.4 1339.9 5
save smoke_data.xisf
open smoke_data.xisf
waitloaded
assert range 0.0 1.0 0.01

quit
