# NebulaScope smoke test — run from the repo root:
#   ./build/src/nebulascope --run tests/smoke.nsc
# Headless (CI):  QT_QPA_PLATFORM=offscreen … --run tests/smoke.nsc
# Also registered as the `smoke` CTest (offscreen, cwd = repo root).
# Outputs are written to the working directory (smoke_*.png/.fits/.xisf,
# gitignored) — relative paths keep this portable to Windows runners.
# Uses the committed synthetic image (128x128 Float32 gradient + gaussian
# stars, values ~50..1340, pixel [0,0] NaN).

open tests/testdata/sample.fits
waitloaded                      # block until decode + stats land (CI-safe)

assert size 128 128
assert channels 1
assert range 50.4 1339.9 5

# Orientation round-trip: the border-bug regression, end to end.
rotate 45
sleep 200
rotate 0
sleep 200
waitloaded
assert size 128 128

# Lossless geometry round-trips preserve the data extremes.
rot90 cw
rot90 ccw
flip h
flip h
assert size 128 128
assert range 50.4 1339.9 5

# Stretch + adjustments exercise the full render path.
autostf
stfall
fn asinh
adjust saturation 0.3
adjust gamma 1.4
reset

export smoke_view.png
save smoke_data.fits

# XISF round-trip through the app: save (normalized to [0,1] with
# NSSCALE/NSZERO keywords, zlib+shuffle blocks), reload, verify.
save smoke_data.xisf
open smoke_data.xisf
waitloaded
assert size 128 128
assert channels 1
assert range 0.0 1.0 0.01

# OSC debayer end to end: the real ASIAIR CFA fixture auto-detects RGGB and
# opens as RGB; forcing off shows the raw mosaic again.
open tests/testdata/cfa_asiair_rggb.fits
waitloaded
assert channels 3
assert size 128 128
debayer off
waitloaded
assert channels 1
debayer auto
waitloaded
assert channels 3

# Debayer changes are undoable: undo the `debayer auto` above (back to the
# raw mosaic), redo it (colour again).
action undo
waitloaded
assert channels 1
action redo
waitloaded
assert channels 3

# Blink culling: tag (checked = keep), sort, remove, move — end to end.
assert rows 3
tag off                          # reject the CFA frame (current)
tagsort                          # unchecked sinks below the keepers
tagremove unchecked
assert rows 2
show 1
waitloaded
save smoke_cull.fits
open smoke_cull.fits
waitloaded
tag off
tagmove unchecked smoke_cull_out
assert rows 3
show 3                           # the moved row re-keyed to its new home
waitloaded
assert size 128 128

# Full-depth crop: a new in-memory entry at the exact size, saveable and
# reloadable (WCS rebasing is covered by the wcs unit tests).
crop 10 20 64 48
waitloaded
assert size 64 48
assert rows 4
save smoke_crop.fits
# Saving an in-memory result rebrands its list row to the saved file —
# so re-opening the file finds the EXISTING row (no new entry).
assert name smoke_crop.fits
open smoke_crop.fits
waitloaded
assert size 64 48
assert rows 4

# The list holds each image once: re-opening a listed file selects the
# existing row instead of appending a duplicate.
open smoke_crop.fits
waitloaded
assert rows 4
assert name smoke_crop.fits

# Clear List & Close All empties the list and every view; the app stays usable.
action clear_list
assert rows 0
open smoke_crop.fits
waitloaded
assert rows 1

quit
